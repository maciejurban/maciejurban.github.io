---
import type { BeatRef } from '../lib/content';

/**
 * Sticky anchor list of the case's beats.
 *
 * Anchors and `scroll-padding-top` only — no JS, no scroll observer, and so
 * nothing to fall back from. Clicking a beat marks it via `:target` in
 * Beat.astro. Hidden below the rail breakpoint, where the beat numbers move
 * inline and the rail would only be a second copy of the same information.
 */
type Props = {
  beats: BeatRef[];
};

const { beats } = Astro.props;
---

{
  beats.length > 0 && (
    <nav class="beat-rail structural" aria-label="Case beats">
      <h2 class="beat-rail__title">Beats</h2>
      <ol>
        {beats.map((beat) => (
          <li>
            <span class="beat-rail__n" aria-hidden="true">
              {String(beat.n).padStart(2, '0')}
            </span>
            <a href={`#${beat.id}`}>{beat.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .beat-rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .beat-rail {
      display: block;
      position: sticky;
      top: var(--space-5);
      align-self: start;
      padding-left: var(--space-5);
      max-width: 16rem;
    }
  }

  .beat-rail__title {
    font-family: var(--font-structural);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-muted);
  }

  ol {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
  }

  .beat-rail__n {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  a {
    font-size: var(--text-sm);
    text-decoration: none;
    text-wrap: pretty;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
</style>
